# =============================================================================
# Stage 1: builder — compile React/Vite SPA
# =============================================================================
FROM node:18-alpine AS builder

WORKDIR /build

# Copy package files first for layer caching
COPY dashboard/package.json dashboard/package-lock.json ./

# Install ALL dependencies (including devDependencies needed for build)
RUN npm ci --prefer-offline

# Copy source code
COPY dashboard/ ./

# Build production bundle
RUN npm run build


# =============================================================================
# Stage 2: runtime — serve with nginx
# =============================================================================
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built SPA from builder stage
COPY --from=builder /build/dist /usr/share/nginx/html

# Create writable temp directories for non-root nginx
RUN mkdir -p /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R nginx:nginx /tmp/client_temp /tmp/proxy_temp /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && touch /tmp/nginx.pid \
    && chown nginx:nginx /tmp/nginx.pid

# Switch to non-root nginx user
USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
