# =============================================================================
# Sentinel AI Platform — Environment Variables
#
# Copy this file to .env and fill in all REQUIRED values before starting.
#   cp .env.example .env
#
# Format: VAR_NAME=value
# REQUIRED variables have no usable default and MUST be set.
# OPTIONAL variables have sensible defaults shown below.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Application display name
# OPTIONAL — default: "Sentinel AI Policy Engine"
APP_NAME=Sentinel AI Policy Engine

# Enable debug mode — set to false in production
# OPTIONAL — default: false
DEBUG=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# OPTIONAL — default: INFO
LOG_LEVEL=INFO

# Runtime environment: development | staging | production
# Controls CORS wildcard guard and other env-specific behavior
# OPTIONAL — default: development
APP_ENV=development


# =============================================================================
# SECURITY  (REQUIRED)
# =============================================================================

# HMAC signing secret for JWT tokens — REQUIRED, no default
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# JWT signing algorithm
# OPTIONAL — default: HS256
ALGORITHM=HS256

# JWT token lifetime in minutes (default = 24 hours)
# OPTIONAL — default: 1440
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Minimum acceptable length for SECRET_KEY
# OPTIONAL — default: 32
MIN_SECRET_KEY_LENGTH=32

# Comma-separated list of accepted JWT audiences
# OPTIONAL — default: ["sentinel-api"]
# ALLOWED_AUDIENCES=["sentinel-api"]


# =============================================================================
# DATABASE  (REQUIRED)
# =============================================================================

# SQLAlchemy connection URL — REQUIRED for PostgreSQL in production
# SQLite (local dev only): sqlite:///./sentinel.db
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://sentinel:REPLACE_WITH_DB_PASSWORD@postgres:5432/sentinel

# PostgreSQL credentials used by docker-compose postgres service
# REQUIRED when running with docker-compose
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Connection pool settings
# OPTIONAL — defaults: pool_size=10, max_overflow=20
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# =============================================================================
# REDIS CACHE  (REQUIRED when REDIS_URL points to auth-protected Redis)
# =============================================================================

# Redis connection URL — REQUIRED in production
# Format: redis://:password@host:6379/db_index
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# Redis password used by docker-compose redis service
# REQUIRED when running with docker-compose
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Cache time-to-live in seconds
# OPTIONAL — default: 300 (5 minutes)
CACHE_TTL=300


# =============================================================================
# CORS
# =============================================================================

# Comma-separated allowed origins. Use "*" only in local dev.
# OPTIONAL — default: ["http://localhost:3000","http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Allow all origins (never true in production — app will refuse to start)
# OPTIONAL — default: false
CORS_ALLOW_ALL_ORIGINS=false

# Allow cookies / Authorization header in cross-origin requests
# OPTIONAL — default: true
CORS_ALLOW_CREDENTIALS=true


# =============================================================================
# API / RATE LIMITING
# =============================================================================

# Header name used for API key authentication
# OPTIONAL — default: X-API-Key
API_KEY_HEADER=X-API-Key

# Maximum requests per minute per client IP
# OPTIONAL — default: 1000
RATE_LIMIT_PER_MINUTE=1000


# =============================================================================
# AUDIT LOG ARCHIVAL
# =============================================================================

# Storage backend for audit log archives: local | s3
# OPTIONAL — default: local
ARCHIVE_BACKEND=local

# Filesystem path for local archive storage (required when ARCHIVE_BACKEND=local)
# OPTIONAL — default: "" (archival disabled)
ARCHIVE_LOCAL_PATH=/var/sentinel/archives

# S3 bucket name (required when ARCHIVE_BACKEND=s3)
# OPTIONAL — default: ""
ARCHIVE_S3_BUCKET=

# S3 key prefix for archived log files
# OPTIONAL — default: audit-logs/
ARCHIVE_S3_PREFIX=audit-logs/

# AWS KMS key ARN or alias for S3 server-side encryption
# Empty = use the bucket's default encryption key
# OPTIONAL — default: ""
ARCHIVE_S3_KMS_KEY_ID=


# =============================================================================
# GITHUB INTEGRATION  (Phase 4 — Model Card Auto-Fill)
# =============================================================================

# GitHub personal access token or App installation token
# Required to pull model card metadata from GitHub repos
# OPTIONAL — default: null (GitHub integration disabled)
GITHUB_TOKEN=

# GitHub API base URL (override for GitHub Enterprise)
# OPTIONAL — default: https://api.github.com
GITHUB_API_BASE_URL=https://api.github.com

# HTTP request timeout for GitHub API calls
# OPTIONAL — default: 10
GITHUB_REQUEST_TIMEOUT_SECONDS=10


# =============================================================================
# MLFLOW INTEGRATION  (Phase 4 — Model Card Auto-Fill)
# =============================================================================

# MLflow tracking server URL
# Required to pull experiment/run metadata for model cards
# OPTIONAL — default: null (MLflow integration disabled)
MLFLOW_TRACKING_URI=

# HTTP request timeout for MLflow API calls
# OPTIONAL — default: 10
MLFLOW_REQUEST_TIMEOUT_SECONDS=10

# Allow non-standard ports in MLFLOW_TRACKING_URI (SSRF mitigation)
# Set to true only if your MLflow instance uses a non-standard port
# OPTIONAL — default: false
MLFLOW_ALLOW_CUSTOM_PORT=false


# =============================================================================
# DICOM INTEGRATION  (Phase 5 — DICOM De-Identification)
# =============================================================================

# Maximum DICOM file size accepted by the /v1/dicom/extract endpoint
# Files larger than this limit receive HTTP 413
# OPTIONAL — default: 50  (50 MB)
DICOM_MAX_FILE_SIZE_MB=50
