# Test environment — safe to commit (no real secrets)
# Loaded by tests/conftest.py before any policy_engine imports
SECRET_KEY=test-secret-key-minimum-32-characters-here
DATABASE_URL=sqlite:///:memory:
REDIS_URL=redis://localhost:6379/0
APP_ENV=testing
ARCHIVE_BACKEND=local
ARCHIVE_LOCAL_PATH=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_PREFIX=audit-logs/

# ── Clinic-tier test additions (Phase 1) ────────────────────────────────
# Stripe test placeholders — never used to hit real Stripe. The webhook
# secret signs every fixture; tests assert tampered signatures fail.
STRIPE_WEBHOOK_SECRET=whsec_test_local_only_do_not_use_in_prod
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER_no_network_calls
STRIPE_PAYMENT_LINK_CLINIC_BASIC=https://buy.stripe.com/test_basic
STRIPE_PAYMENT_LINK_CLINIC_STANDARD=https://buy.stripe.com/test_standard
STRIPE_PAYMENT_LINK_CLINIC_MULTI_SITE=https://buy.stripe.com/test_multisite
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/clinic/settings/billing

# Anthropic placeholder — respx intercepts every call; never hits the API.
ANTHROPIC_API_KEY=sk-ant-test-PLACEHOLDER

# Schedulers OFF in tests — the lifespan hook would otherwise register
# background jobs that mutate the in-memory DB out from under tests.
# Names match the actual is_enabled() reads in each service module.
# NOTE: There is also a real production bug in policy_engine/main.py — the
# lifespan re-registers the same job name on every TestClient entry, and
# scheduler.register() raises ValueError on duplicate (scheduler.py:73).
# These flags work around it for tests; the prod fix belongs in main.py.
CLINIC_LIFECYCLE_AUTO=false
CLINIC_RETENTION_AUTO=false
CLINIC_REPORT_AUTO_GENERATE=false
